<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Sketchbot Studio Launcher" Language="1033" Version="$(var.Version)"
      Manufacturer="Sketchbot Studio" UpgradeCode="B8812DA3-67B4-4F96-8AD8-A2F218D3282D">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perUser" />
    <Media Id="1" Cabinet="launcher.cab" EmbedCab="yes" />
    <MajorUpgrade DowngradeErrorMessage="A newer Sketchbot launcher is already installed." />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder"><Directory Id="INSTALLDIR" Name="Sketchbot Studio">
        <Component Id="Launcher" Guid="AA35E384-9AE4-4501-9839-1DD45A1FC4BF">
          <File Id="LauncherUrl" Source="Sketchbot.url" Name="Sketchbot Studio.url" />
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Sketchbot Studio" Target="[#LauncherUrl]" WorkingDirectory="INSTALLDIR" />
          <RemoveFolder Id="RemoveInstallDirectory" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\Sketchbot\Studio" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory></Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>
    <Feature Id="Complete" Title="Sketchbot Studio browser launcher" Level="1"><ComponentRef Id="Launcher" /></Feature>
  </Product>
</Wix>