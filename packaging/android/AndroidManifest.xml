<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.sketchbot.studio">
  <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="35" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-feature android:name="android.hardware.camera" android:required="false" />
  <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
  <queries><intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent></queries>
  <application android:label="Sketchbot Studio" android:theme="@android:style/Theme.Material.Light.NoActionBar"
      android:allowBackup="false" android:usesCleartextTraffic="true" android:icon="@drawable/icon">
    <activity android:name=".StudioActivity" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden">
      <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
    </activity>
    <provider android:name=".PhotoProvider" android:authorities="com.sketchbot.studio.photos"
      android:exported="false" android:grantUriPermissions="true" />
  </application>
</manifest>