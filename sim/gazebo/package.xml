<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>braccio_sim</name>
  <version>0.1.0</version>
  <description>Sketchbot M/S bridge for the unoq_braccio_sim Gazebo model.</description>
  <maintainer email="hello@edgeimpulse.com">Edge Impulse</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <!-- Provides the Braccio Gazebo model + the deg->rad / controller bridges. -->
  <exec_depend>unoq_braccio_sim</exec_depend>
  <exec_depend>unoq_braccio_driver</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
