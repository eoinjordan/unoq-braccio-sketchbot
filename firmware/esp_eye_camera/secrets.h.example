// Copy this file to `secrets.h` (same folder) and fill in your Wi-Fi details.
// `secrets.h` is git-ignored so your credentials never get committed.
//
// Leave WIFI_SSID as "" to skip Wi-Fi and run the camera over USB only.

#define WIFI_SSID "your-wifi-name"
#define WIFI_PASS "your-wifi-password"

// Optional: mDNS name, reachable as http://<HOSTNAME>.local/
#define HOSTNAME "esp-eye"
