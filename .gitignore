# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env
.env.*
*.env

# Arduino / App Lab build caches (can be large; regenerated on build)
.cache/

# Firmware Wi-Fi credentials (copy secrets.h.example -> secrets.h locally)
firmware/**/secrets.h

# Generated output (sketches, previews, gallery cards)
output/
config/homography.json

# Brand assets that shouldn't be committed (drop your own locally)
assets/edge_impulse_logo.png
assets/qr.png

# OS / editor
.DS_Store
.vscode/

# Downloaded models (fetch with scripts/fetch_lineart_model.sh)
models/

# Braccio meshes copied from the companion unoq-braccio repo. They are
# GPL-3.0 and this repo is MIT, which is why the README says to fetch them
# locally rather than vendor them. Ignored so a `git add -A` cannot pull them
# into the tree by accident.
hardware/braccio/
